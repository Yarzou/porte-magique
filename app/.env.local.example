# Modèle de .env.local (versionné — AUCUNE valeur réelle ici).
# Copier en .env.local, qui est gitignoré.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clé « publishable » (sb_publishable_…) ou anon : lue aussi par les passerelles
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « secret » (sb_secret_…) — serveur uniquement : inscription, mot de passe
# oublié, notifications aux autres membres
SUPABASE_SERVICE_ROLE_KEY=
# Mot de passe de la base, lu par scripts/db-migrate.js (Liquibase), jamais par l'appli
SUPABASE_DB_PASSWORD=
# Hôte du pooler « Transaction » (bouton Connect), ex. aws-1-eu-west-3.pooler.supabase.com
SUPABASE_POOLER_HOST=
# Optionnels pour db-migrate.js : SUPABASE_DB_URL, SUPABASE_DB_USER

# ─── Application ─────────────────────────────────────────────────────────────
# Origine utilisée dans les liens des emails (confirmation, mot de passe, invitation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email (SMTP Gmail, mêmes noms que Fridge) ──────────────────────────────
# Sans ces deux variables, l'inscription retombe sur le mailer Supabase,
# qui ne livre qu'aux membres de l'équipe du projet.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Cron keepalive ──────────────────────────────────────────────────────────
# Optionnel : si défini, /api/keepalive l'exige (le cron Vercel l'envoie seul).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ─── Notifications sur le téléphone (Web Push) ──────────────────────────────
# Paire de clés VAPID, à générer une fois : npx web-push generate-vapid-keys
# Changer de paire oblige chaque appareil à réactiver ses notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optionnel : contact donné aux services push (mailto: ou https:). Par défaut : mailto:GMAIL_USER.
# VAPID_SUBJECT=mailto:vous@exemple.fr
